# Base URL of cms-server. Read by the Electron main process at startup.
CMS_API_BASE_URL=http://localhost:1255/api/v1

# Optional: path to NXP JCShell, used by the "install applet" wizard step.
# Leave empty to disable that step (cards that already carry the applet are
# personalized fine without it).
JCSHELL_PATH=
