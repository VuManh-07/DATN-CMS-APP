{
  "compilerOptions": {
    "target": "es2019",
    "types": ["jest", "node"],
    "lib": ["es2019", "dom"],
    "module": "commonjs",
    "moduleResolution": "node",
    "sourceMap": true,
    "esModuleInterop": true,
    "downlevelIteration": true,
    "removeComments": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "allowJs": false,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "importHelpers": true,
    "baseUrl": ".",
    "outDir": "./dist"
  },
  "include": ["src/**/*.ts", "server.ts", "standalone.ts"],
  "exclude": ["dist", "node_modules", "tests/**/*", "**/*.(spec|test).ts"]
}
