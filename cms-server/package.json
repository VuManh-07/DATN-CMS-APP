{
  "name": "cms-server",
  "version": "1.0.0",
  "description": "Card Management System server: SCP03 key authority + card lifecycle management",
  "main": "server.ts",
  "scripts": {
    "build": "tsc && tsc-alias",
    "server:pro": "node dist/server.js",
    "server:dev": "ts-node-dev --exit-child --respawn -r tsconfig-paths/register server.ts",
    "seed": "ts-node -r tsconfig-paths/register src/scripts/seedAdmin.ts",
    "test": "jest -c jest.config.js",
    "dev:standalone": "ts-node standalone.ts",
    "seed:demo": "ts-node -r tsconfig-paths/register src/scripts/seedDemo.ts"
  },
  "keywords": [
    "smartcard",
    "scp03",
    "globalplatform",
    "cms"
  ],
  "license": "ISC",
  "dependencies": {
    "aes-cmac": "^3.0.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.3",
    "morgan": "^1.10.0",
    "redis": "^4.6.14",
    "redis-om": "^0.4.3",
    "tsc-alias": "^1.8.10",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.8",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.3.0",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.6.3",
    "typescript": "^5.5.2"
  },
  "resolutions": {
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^4.19.0"
  }
}
