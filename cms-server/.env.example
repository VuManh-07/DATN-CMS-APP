NODE_ENV=dev

# --- App ---
DEV_APP_PORT=1255

# --- MongoDB ---
# Never commit real credentials. Copy this file to .env and fill in.
#
# Local:
#   DEV_MONGODB_URL_CONNECT=mongodb://localhost:27017
#
# Atlas (SRV): paste the string from Connect > Drivers. Leave the database name
# out of it — DEV_MONGODB_NAME below is inserted in the right place, before any
# query options. Replace <db_username>/<password> with a real Atlas DB user,
# and percent-encode any of @ : / ? # [ ] in the password.
#   DEV_MONGODB_URL_CONNECT=mongodb+srv://myuser:mypass@datn.pywijgp.mongodb.net/?retryWrites=true&w=majority
#
# Atlas also needs your IP in Network Access, or connection times out.
DEV_MONGODB_URL_CONNECT=mongodb://localhost:27017
DEV_MONGODB_NAME=cmsDB

# --- Redis (SCP03 live session store) ---
DEV_REDIS_HOST=localhost
DEV_REDIS_PORT=6379
DEV_REDIS_USERNAME=
DEV_REDIS_PASSWORD=

# --- JWT ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=7d

# --- Key Encryption Key (KEK) ---
# 32-byte hex. Wraps SCP03 master keys at rest (AES-256-GCM).
# In production this must come from an HSM, not an env var.
KEK_HEX=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f

# --- SCP03 session ---
SCP03_SESSION_TTL_SECONDS=900

# --- Seed admin (used by `yarn seed`) ---
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_PASSWORD=ChangeMe123!
